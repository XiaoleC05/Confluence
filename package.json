{
  "name": "dsh-confluence",
  "version": "0.2.1",
  "private": true,
  "description": "Fully-offline DeepSeek Harness plugin that gives every session one universal shared memory (Confluence / 高级记忆): a passive pulse, a durable shared board, on-demand recall, a read-only panel and an opt-in export — independent of the working directory.",
  "author": "XiaoleC05",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoleC05/Confluence.git"
  },
  "homepage": "https://github.com/XiaoleC05/Confluence#readme",
  "bugs": {
    "url": "https://github.com/XiaoleC05/Confluence/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test --test-force-exit \"test/*.test.js\"",
    "check": "node scripts/check.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "confluence",
    "universal-memory",
    "offline"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
